{
  "openapi": "3.1.0",
  "info": {
    "title": "VoiceBook AI API",
    "version": "0.2.0"
  },
  "paths": {
    "/api/departments": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Departments",
        "operationId": "list_departments_api_departments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DepartmentOut"
                  },
                  "type": "array",
                  "title": "Response List Departments Api Departments Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/doctors": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Doctors",
        "operationId": "list_doctors_api_doctors_get",
        "parameters": [
          {
            "name": "department_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Department Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DoctorOut"
                  },
                  "title": "Response List Doctors Api Doctors Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Services",
        "operationId": "list_services_api_services_get",
        "parameters": [
          {
            "name": "department_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Department Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceOut"
                  },
                  "title": "Response List Services Api Services Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendar/availability": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Availability",
        "operationId": "availability_api_calendar_availability_get",
        "parameters": [
          {
            "name": "doctor_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Doctor Id"
            }
          },
          {
            "name": "service_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Service Id"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date From"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date To"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/patients": {
      "post": {
        "tags": [
          "appointments"
        ],
        "summary": "Upsert Patient",
        "description": "Return the existing patient for this phone number, or create one.",
        "operationId": "upsert_patient_api_patients_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/patients/by-phone": {
      "get": {
        "tags": [
          "appointments"
        ],
        "summary": "Find Patient By Phone",
        "description": "Repeat-caller lookup. The voice agent passes the caller's number here.",
        "operationId": "find_patient_by_phone_api_patients_by_phone_get",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Phone"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/patients/{patient_id}/appointments": {
      "get": {
        "tags": [
          "appointments"
        ],
        "summary": "List Patient Appointments",
        "description": "Active bookings for a patient. The agent uses this to find which one to change.",
        "operationId": "list_patient_appointments_api_patients__patient_id__appointments_get",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Patient Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentOut"
                  },
                  "title": "Response List Patient Appointments Api Patients  Patient Id  Appointments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments": {
      "post": {
        "tags": [
          "appointments"
        ],
        "summary": "Book",
        "operationId": "book_api_appointments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/appointments/{appt_id}": {
      "get": {
        "tags": [
          "appointments"
        ],
        "summary": "Get Appointment",
        "operationId": "get_appointment_api_appointments__appt_id__get",
        "parameters": [
          {
            "name": "appt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Appt Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "appointments"
        ],
        "summary": "Update Appointment",
        "description": "Reschedule (send start_time) or cancel (send status='cancelled').",
        "operationId": "update_appointment_api_appointments__appt_id__patch",
        "parameters": [
          {
            "name": "appt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Appt Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppointmentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "patient_id": {
            "type": "integer",
            "title": "Patient Id"
          },
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id"
          },
          "service_id": {
            "type": "integer",
            "title": "Service Id"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "title": "End Time"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "doctor_id",
          "service_id",
          "start_time",
          "end_time",
          "status"
        ],
        "title": "AppointmentOut"
      },
      "AppointmentUpdate": {
        "properties": {
          "start_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "cancelled"
                ],
                "const": "cancelled"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "title": "AppointmentUpdate",
        "description": "Send start_time to reschedule, or status='cancelled' to cancel."
      },
      "AvailabilityOut": {
        "properties": {
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id"
          },
          "service_id": {
            "type": "integer",
            "title": "Service Id"
          },
          "slots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "service_id",
          "slots"
        ],
        "title": "AvailabilityOut"
      },
      "BookingIn": {
        "properties": {
          "patient_id": {
            "type": "integer",
            "title": "Patient Id"
          },
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id"
          },
          "service_id": {
            "type": "integer",
            "title": "Service Id"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          }
        },
        "type": "object",
        "required": [
          "patient_id",
          "doctor_id",
          "service_id",
          "start_time"
        ],
        "title": "BookingIn"
      },
      "DepartmentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "DepartmentOut"
      },
      "DoctorOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "department_id": {
            "type": "integer",
            "title": "Department Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "department_id"
        ],
        "title": "DoctorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PatientIn": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{7,15}$",
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "PatientIn"
      },
      "PatientOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "id",
          "full_name",
          "phone"
        ],
        "title": "PatientOut"
      },
      "ServiceOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "duration_minutes": {
            "type": "integer",
            "title": "Duration Minutes"
          },
          "department_id": {
            "type": "integer",
            "title": "Department Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "duration_minutes",
          "department_id"
        ],
        "title": "ServiceOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}